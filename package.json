{
  "name": "pair-formance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:reference && vite build",
    "build:reference": "node scripts/build-reference.ts",
    "check:reference": "node scripts/check-reference.ts",
    "preview": "vite preview",
    "prepare": "effect-tsgo patch --typescript --force --typescript-package @typescript/native",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.node.json && node node_modules/@typescript/native/bin/tsc -p scripts/tsconfig.json",
    "check:svelte": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "check": "pnpm check:reference && pnpm typecheck && pnpm check:svelte && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@noble/hashes": "2.4.0",
    "@strudel/web": "1.3.0",
    "acorn": "8.18.0",
    "acorn-loose": "8.5.2",
    "effect": "3.22.2",
    "hydra-synth": "1.4.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.0",
    "@effect/vitest": "0.30.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "3.2.7",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["svelte", "vite/client", "@vitest/browser/providers/playwright"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectErrorsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "diagnosticSeverity": {
          "runEffectInsideEffect": "error",
          "returnEffectInGen": "error",
          "nestedEffectGenYield": "error",
          "effectInFailure": "error",
          "effectInVoidSuccess": "error",
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "tryCatchInEffectGen": "error",
          "abortControllerInEffect": "error",
          "strictEffectProvide": "error",
          "globalDateInEffect": "error",
          "globalTimersInEffect": "error",
          "globalRandomInEffect": "error",
          "globalConsoleInEffect": "error",
          "globalFetchInEffect": "error",
          "cryptoRandomUUIDInEffect": "error",
          "processEnvInEffect": "error"
        },
        "overrides": [
          {
            "include": ["src/core/**/*"],
            "exclude": ["src/**/*.test.ts"],
            "options": {
              "diagnosticSeverity": {
                "globalDate": "error",
                "globalTimers": "error",
                "globalRandom": "error",
                "globalConsole": "error",
                "globalFetch": "error",
                "cryptoRandomUUID": "error",
                "processEnv": "error",
                "newPromise": "error",
                "asyncFunction": "error",
                "extendsNativeError": "error"
              }
            }
          },
          {
            "include": ["src/facade/**/*", "src/**/*.test.ts"],
            "options": {
              "diagnosticSeverity": {
                "strictEffectProvide": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
